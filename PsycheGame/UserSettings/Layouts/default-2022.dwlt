    0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.StickyNoteData\",\n    \"m_ObjectId\":
    \"9f8ce404007649f082ab2e25dbe5c706\",\n    \"m_Title\": \"Scale To Screen\",\n   
    \"m_Content\": \"Compute the aspect ratio of the screen and obtain the X screen
    coordinate (R). We then multiply the X coordinate by the aspect ratio to scale
    it to prevent any stretching. Finally the X and Y coordinates are combined back
    into a single value.\",\n    \"m_TextSize\": 0,\n    \"m_Theme\": 1,\n    \"m_Position\":
    {\n        \"serializedVersion\": \"2\",\n        \"x\": -3519.0,\n        \"y\":
    76.0,\n        \"width\": 869.0,\n        \"height\": 424.0\n    },\n    \"m_Group\":
    {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\":
    \"UnityEditor.ShaderGraph.StickyNoteData\",\n    \"m_ObjectId\": \"a0312c07bdf844d9bc21e5378d4ec03e\",\n   
    \"m_Title\": \"Star Creation\",\n    \"m_Content\": \"This unit creates stars
    given a clip threshold and random seed. Stars are created by clamping the color
    values of a voronoi noise function to it's brightest points, the 'ClipThreshold'
    function controls this parameter controls this functionallity. The 'Seed' controls
    the angle offset of the noise and thus controls the random factor of the noise
    with a value of 0 being uniform!\",\n    \"m_TextSize\": 0,\n    \"m_Theme\":
    1,\n    \"m_Position\": {\n        \"serializedVersion\": \"2\",\n        \"x\":
    -1849.0,\n        \"y\": 381.0,\n        \"width\": 640.0,\n        \"height\":
    608.0\n    },\n    \"m_Group\": {\n        \"m_Id\": \"\"\n    }\n}\n\n{\n   
